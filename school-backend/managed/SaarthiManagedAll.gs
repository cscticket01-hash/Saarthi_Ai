function listTeacherAttendance(data) {
  const sheet =
    getOrCreateDatabaseSheet(
      TEACHER_ATTENDANCE_SHEET_NAME,
      TEACHER_ATTENDANCE_HEADERS
    );

  const teacherId = String(
    data.teacherId ||
    data.personId ||
    ""
  ).trim();

  const phone =
    normalizePhone(
      data.phone ||
      data.mobile ||
      ""
    );

  const dateKey = String(
    data.dateKey ||
    data.date ||
    ""
  ).trim();

  const rows =
    sheet.getLastRow() <= 1
      ? []
      : sheet
          .getRange(
            2,
            1,
            sheet.getLastRow() - 1,
            TEACHER_ATTENDANCE_HEADERS.length
          )
          .getValues();

  const attendance = [];

  for (
    let i = rows.length - 1;
    i >= 0;
    i--
  ) {
    const item =
      teacherAttendanceRowToObject(
        rows[i]
      );

    if (
      teacherId &&
      item.teacherId !== teacherId
    ) {
      continue;
    }

    if (
      phone &&
      normalizePhone(item.phone) !== phone
    ) {
      continue;
    }

    if (
      dateKey &&
      item.dateKey !== dateKey
    ) {
      continue;
    }

    attendance.push(item);
  }

  return jsonResponse({
    success: true,
    action:
      "list_teacher_attendance",
    count: attendance.length,
    attendance: attendance,
    sheetUrl:
      sheet.getParent().getUrl()
  });
}


