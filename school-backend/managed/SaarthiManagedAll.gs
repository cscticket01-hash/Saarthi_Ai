function schoolProfileAssetExtension(mimeType) {
  const mime = String(mimeType || "image/png").toLowerCase();
  if (mime.includes("jpeg") || mime.includes("jpg")) return ".jpg";
  if (mime.includes("webp")) return ".webp";
  if (mime.includes("gif")) return ".gif";
  return ".png";
}


function saveSchoolProfileAsset(options) {
  const base64Value = String(options.base64Value || "").trim();

  if (!base64Value) {
    return {
      url: String(options.oldUrl || "").trim(),
      fileId: String(options.oldFileId || "").trim()
    };
  }

  const mimeType = String(options.mimeType || "image/png").trim();
  const cleanBase64 = base64Value.replace(
    /^data:image\/[\w.+-]+;base64,/i,
    ""
  );

  const bytes = Utilities.base64Decode(cleanBase64);
  if (!bytes || bytes.length === 0) {
    throw new Error(options.label + " image empty hai");
  }

  const folder = options.folder || getOrCreateFolder(SCHOOL_PROFILE_ASSET_FOLDER);
  const extension = schoolProfileAssetExtension(mimeType);
  const requestedName = String(options.fileName || "").trim();
  const defaultName = safeDriveFileName(options.label) + extension;
  const fileName = requestedName
    ? safeDriveFileName(requestedName.replace(/\.[^.]+$/, "")) + extension
    : defaultName;

  const blob = Utilities.newBlob(bytes, mimeType, fileName);
  const newFile = folder.createFile(blob);

  try {
    newFile.setSharing(
      DriveApp.Access.ANYONE_WITH_LINK,
      DriveApp.Permission.VIEW
    );
  } catch (sharingError) {
    console.log(
      "School profile sharing warning (" +
      options.label +
      "): " +
      sharingError
    );
  }

  const oldFileId = String(options.oldFileId || "").trim();
  if (oldFileId && oldFileId !== newFile.getId()) {
    try {
      VS_schoolFile(oldFileId).setTrashed(true);
    } catch (deleteError) {
      console.log(
        "Old school profile asset cleanup warning: " + deleteError
      );
    }
  }

  return {
    fileId: newFile.getId(),
    url:
      "https://lh3.googleusercontent.com/d/" +
      newFile.getId() +
      "=w1600"
  };
}


function saveSchoolProfile(data) {
  const schoolName = String(data.schoolName || "").trim();
  const principalName = String(data.principalName || "").trim();
  const schoolContactNo = String(data.schoolContactNo || "").trim();
  const latitude = String(data.latitude ?? "").trim();
  const longitude = String(data.longitude ?? "").trim();
  const attendanceRadiusMeters = Number(data.attendanceRadiusMeters || 200);

  if (!schoolName) {
    throw new Error("School Name required hai");
  }

  if (!principalName) {
    throw new Error("Principal Name required hai");
  }

  // Reuse one Sheet lookup for both current profile and save.
  const sheet = getOrCreateDatabaseSheet(
    SCHOOL_PROFILE_SHEET_NAME,
    SCHOOL_PROFILE_HEADERS
  );

  const existing = sheet.getLastRow() <= 1
    ? schoolProfileDefaults()
    : schoolProfileRowToObject(
        sheet
          .getRange(2, 1, 1, SCHOOL_PROFILE_HEADERS.length)
          .getValues()[0]
      );

  // Reuse one Drive folder lookup when one or more images changed.
  const hasAssetUpload = Boolean(
    String(data.logoBase64 || "").trim() ||
    String(data.sealBase64 || "").trim() ||
    String(data.principalSignatureBase64 || "").trim()
  );
  const assetFolder = hasAssetUpload
    ? getOrCreateFolder(SCHOOL_PROFILE_ASSET_FOLDER)
    : null;

  const logo = saveSchoolProfileAsset({
    label: "School_Logo",
    base64Value: data.logoBase64,
    mimeType: data.logoMimeType,
    fileName: data.logoFileName,
    oldUrl: existing.logoUrl,
    oldFileId: existing.logoFileId,
    folder: assetFolder
  });

  const seal = saveSchoolProfileAsset({
    label: "School_Seal",
    base64Value: data.sealBase64,
    mimeType: data.sealMimeType,
    fileName: data.sealFileName,
    oldUrl: existing.sealUrl,
    oldFileId: existing.sealFileId,
    folder: assetFolder
  });

  const signature = saveSchoolProfileAsset({
    label: "Principal_Signature",
    base64Value: data.principalSignatureBase64,
    mimeType: data.principalSignatureMimeType,
    fileName: data.principalSignatureFileName,
    oldUrl: existing.principalSignatureUrl,
    oldFileId: existing.principalSignatureFileId,
    folder: assetFolder
  });

  const updatedBy = String(data.updatedBy || "Admin").trim();
  const now = new Date();

  const rowValues = [
    schoolName,
    principalName,
    logo.url,
    logo.fileId,
    seal.url,
    seal.fileId,
    signature.url,
    signature.fileId,
    updatedBy,
    now,
    schoolContactNo,
    latitude,
    longitude,
    attendanceRadiusMeters
  ];

  if (sheet.getLastRow() <= 1) {
    sheet.appendRow(rowValues);
  } else {
    sheet
      .getRange(2, 1, 1, SCHOOL_PROFILE_HEADERS.length)
      .setValues([rowValues]);
  }

  const profile = schoolProfileRowToObject(rowValues);

  return jsonResponse({
    success: true,
    action: "save_school_profile",
    message: "School profile Google Drive me save ho gaya",
    profile: profile,
    sheetUrl: sheet.getParent().getUrl()
  });
}


