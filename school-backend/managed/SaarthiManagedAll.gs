function saveExam(data) {
  const examName = String(data.examName || "").trim();
  const studentClass = String(
    data.studentClass ||
    data.class ||
    ""
  ).trim();

  const subjects = Array.isArray(data.subjects)
    ? data.subjects
        .map(function(value) {
          return String(value || "").trim();
        })
        .filter(function(value) {
          return !!value;
        })
    : [];

  const fullMarks = Number(data.fullMarks || 0);
  const passMarks = Number(data.passMarks || 0);

  if (!examName) {
    throw new Error("Exam name required hai");
  }

  if (!studentClass) {
    throw new Error("Class required hai");
  }

  if (!subjects.length) {
    throw new Error("Kam se kam ek subject required hai");
  }

  if (
    !isFinite(fullMarks) ||
    fullMarks <= 0
  ) {
    throw new Error("Full marks invalid hai");
  }

  if (
    !isFinite(passMarks) ||
    passMarks < 0 ||
    passMarks > fullMarks
  ) {
    throw new Error("Pass marks invalid hai");
  }

  const examId = String(
    data.examId ||
    (
      "EXM-" +
      new Date().getTime() +
      "-" +
      Utilities.getUuid()
        .substring(0, 6)
        .toUpperCase()
    )
  ).trim();

  const sheet = getOrCreateDatabaseSheet(
    EXAM_SHEET_NAME,
    EXAM_HEADERS
  );

  const rowValues = [
    examId,
    examName,
    studentClass,
    JSON.stringify(subjects),
    fullMarks,
    passMarks,
    String(data.createdBy || "").trim(),
    new Date()
  ];

  const existingRow = findRowByFirstColumn(
    sheet,
    examId
  );

  if (existingRow > 1) {
    sheet
      .getRange(
        existingRow,
        1,
        1,
        EXAM_HEADERS.length
      )
      .setValues([rowValues]);
  } else {
    sheet.appendRow(rowValues);
  }

  return jsonResponse({
    success: true,
    action: "save_exam",
    message: "Exam saved successfully",
    exam: {
      examId: examId,
      examName: examName,
      studentClass: studentClass,
      subjects: subjects,
      fullMarks: fullMarks,
      passMarks: passMarks,
      createdBy: String(data.createdBy || "").trim(),
      timestamp: new Date().getTime()
    },
    sheetUrl: sheet.getParent().getUrl()
  });
}


function saveExamResult(data) {
  const examId = String(data.examId || "").trim();
  const studentId = String(data.studentId || "").trim();

  if (!examId || !studentId) {
    throw new Error("Exam ID aur Student ID required hain");
  }

  const examSheet = getOrCreateDatabaseSheet(
    EXAM_SHEET_NAME,
    EXAM_HEADERS
  );

  const examRow = findRowByFirstColumn(
    examSheet,
    examId
  );

  if (examRow === -1) {
    throw new Error("Exam record nahi mila");
  }

  const examValues = examSheet
    .getRange(
      examRow,
      1,
      1,
      EXAM_HEADERS.length
    )
    .getValues()[0];

  let subjects = [];

  try {
    subjects = JSON.parse(
      String(examValues[3] || "[]")
    );
  } catch (_) {
    subjects = [];
  }

  if (!Array.isArray(subjects) || !subjects.length) {
    throw new Error("Exam subjects invalid hain");
  }

  const fullMarks = Number(examValues[4] || 0);
  const passMarks = Number(examValues[5] || 0);
  const incomingMarks =
    data.marks &&
    typeof data.marks === "object" &&
    !Array.isArray(data.marks)
      ? data.marks
      : {};

  const finalMarks = {};
  let total = 0;
  let passedEverySubject = true;

  subjects.forEach(function(subject) {
    const mark = Number(incomingMarks[subject]);

    if (
      !isFinite(mark) ||
      mark < 0 ||
      mark > fullMarks
    ) {
      throw new Error(
        subject +
        " marks 0 se " +
        fullMarks +
        " ke beech hona chahiye"
      );
    }

    finalMarks[subject] = mark;
    total += mark;

    if (mark < passMarks) {
      passedEverySubject = false;
    }
  });

  const maximum = fullMarks * subjects.length;
  const percentage = maximum > 0
    ? Number(
        (
          total * 100 / maximum
        ).toFixed(2)
      )
    : 0;

  const resultText =
    passedEverySubject
      ? "PASS"
      : "FAIL";

  const grade = examGrade(
    percentage,
    passedEverySubject
  );

  const exam = {
    examId: examId,
    examName: String(examValues[1] || ""),
    studentClass: String(examValues[2] || ""),
    subjects: subjects,
    fullMarks: fullMarks,
    passMarks: passMarks
  };

  const resultData = {
    examId: examId,
    examName: exam.examName,
    studentId: studentId,
    studentName: String(data.studentName || "").trim(),
    studentClass: String(
      data.studentClass ||
      data.class ||
      exam.studentClass
    ).trim(),
    rollNo: String(data.rollNo || data.roll || "").trim(),
    marks: finalMarks,
    total: total,
    maximum: maximum,
    percentage: percentage,
    grade: grade,
    result: resultText,
    updatedBy: String(data.updatedBy || "").trim()
  };

  const reportCard = createExamReportCardPdf(
    exam,
    resultData
  );

  const resultSheet = getOrCreateDatabaseSheet(
    EXAM_RESULT_SHEET_NAME,
    EXAM_RESULT_HEADERS
  );

  const rowValues = [
    examId,
    exam.examName,
    studentId,
    resultData.studentName,
    resultData.studentClass,
    resultData.rollNo,
    JSON.stringify(finalMarks),
    total,
    maximum,
    percentage,
    grade,
    resultText,
    reportCard.fileUrl,
    resultData.updatedBy,
    new Date()
  ];

  const existingRow = findExamResultRow(
    resultSheet,
    examId,
    studentId
  );

  if (existingRow > 1) {
    const oldUrl = String(
      resultSheet
        .getRange(
          existingRow,
          13
        )
        .getValue() ||
      ""
    ).trim();

    resultSheet
      .getRange(
        existingRow,
        1,
        1,
        EXAM_RESULT_HEADERS.length
      )
      .setValues([rowValues]);

    if (oldUrl && oldUrl !== reportCard.fileUrl) {
      try {
        const oldId = extractDriveFileId(oldUrl);
        if (oldId) {
          DriveApp
            .getFileById(oldId)
            .setTrashed(true);
        }
      } catch (error) {
        console.log(
          "Old report card delete warning: " +
          error
        );
      }
    }
  } else {
    resultSheet.appendRow(rowValues);
  }

  resultData.reportCardUrl =
    reportCard.fileUrl;
  resultData.timestamp =
    new Date().getTime();

  return jsonResponse({
    success: true,
    action: "save_exam_result",
    message:
      "Marks saved aur report card Google Drive me generate ho gaya",
    result: resultData,
    sheetUrl: resultSheet.getParent().getUrl()
  });
}


function createExamReportCardPdf(
  exam,
