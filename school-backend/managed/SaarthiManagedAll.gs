// ============================================================
// CHANGE STUDENT CLASS - PROMOTE / DEMOTE
// Updates current student class in Google Sheet and migrates
// Student Document index IDs so documents remain attached.
// Historical fees / attendance / exam results are intentionally
// kept unchanged as history.
// ============================================================

function changeStudentClass(data) {
  const oldClass = String(
    data.oldClass ||
    data.studentClass ||
    data.class ||
    ""
  ).trim();

  const newClass = String(
    data.newClass || ""
  ).trim();

  const rollNo = String(
    data.rollNo ||
    data.roll ||
    ""
  ).trim();

  const oldStudentId = String(
    data.oldStudentId || ""
  ).trim();

  const newStudentId = String(
    data.newStudentId || ""
  ).trim();

  const movement = String(
    data.movement || "CLASS_CHANGE"
  ).trim();

  if (!oldClass || !newClass || !rollNo) {
    throw new Error(
      "Old Class, New Class aur Roll No required hain"
    );
  }

  if (normalizeClass(oldClass) === normalizeClass(newClass)) {
    return jsonResponse({
      success: true,
      action: "change_student_class",
      alreadyChanged: true,
      oldClass: oldClass,
      newClass: newClass,
      rollNo: rollNo,
      message: "Student already requested class me hai"
    });
  }

  const studentSheet = getOrCreateDatabaseSheet(
    STUDENT_SHEET_NAME,
    STUDENT_HEADERS
  );

  let oldRow = findStudentRow(
    studentSheet,
    oldClass,
    rollNo
  );

  const newRow = findStudentRow(
    studentSheet,
    newClass,
    rollNo
  );

  // Retry-safe: backend already changed but client retried.
  if (oldRow === -1 && newRow > 1) {
    oldRow = newRow;
  } else if (newRow > 1 && newRow !== oldRow) {
    throw new Error(
      newClass + " me Roll " + rollNo + " already exist karta hai"
    );
  }

  if (oldRow === -1) {
    throw new Error(
      "Student old class me Google Sheet par nahi mila"
    );
  }

  studentSheet
    .getRange(oldRow, 3)
    .setValue(newClass);

  studentSheet
    .getRange(oldRow, STUDENT_HEADERS.length)
    .setValue(new Date());

  let documentsUpdated = 0;

  // Keep Student All Documents attached after Firestore doc ID changes.
  try {
    const documentSheet = getOrCreateDatabaseSheet(
      STUDENT_DOCUMENT_INDEX_SHEET,
      STUDENT_DOCUMENT_HEADERS
    );

    if (documentSheet.getLastRow() > 1) {
      const rowCount = documentSheet.getLastRow() - 1;
      const rows = documentSheet
        .getRange(
          2,
          1,
          rowCount,
          STUDENT_DOCUMENT_HEADERS.length
        )
        .getValues();

      for (let i = 0; i < rows.length; i++) {
        const rowStudentId = String(rows[i][1] || "").trim();
        const rowClass = normalizeClass(rows[i][3]);
        const rowRoll = normalizeRoll(rows[i][4]);

        const idMatch =
          !!oldStudentId && rowStudentId === oldStudentId;

        const classRollMatch =
          rowClass === normalizeClass(oldClass) &&
          rowRoll === normalizeRoll(rollNo);

        if (!idMatch && !classRollMatch) {
          continue;
        }

        if (newStudentId) {
          rows[i][1] = newStudentId;
        }
        rows[i][3] = newClass;
        documentsUpdated++;
      }

      if (documentsUpdated > 0) {
        documentSheet
          .getRange(
            2,
            1,
            rowCount,
            STUDENT_DOCUMENT_HEADERS.length
          )
          .setValues(rows);
      }
    }
  } catch (documentError) {
    console.log(
      "Student document migration warning: " + documentError
    );
  }

  return jsonResponse({
    success: true,
    action: "change_student_class",
    movement: movement,
    oldClass: oldClass,
    newClass: newClass,
    rollNo: rollNo,
    oldStudentId: oldStudentId,
    newStudentId: newStudentId,
    documentsUpdated: documentsUpdated,
    message:
      "Student class Google Sheet me update ho gaya"
  });
}


// ============================================================
// FIND STUDENT
// ============================================================

function findStudentRow(
  sheet,
  studentClass,
  rollNo
) {

  const lastRow =
    sheet.getLastRow();


  if (lastRow <= 1) {
    return -1;
  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        Math.max(
          sheet.getLastColumn(),
          STUDENT_HEADERS.length
        )
      )
      .getValues();


  const requestedClass =
    normalizeClass(
      studentClass
    );

  const requestedRoll =
    normalizeRoll(
      rollNo
    );


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const rowClass =
      normalizeClass(
        values[i][2]
      );

    const rowRoll =
      normalizeRoll(
        values[i][3]
      );


    if (
      rowClass ===
        requestedClass &&
      rowRoll ===
        requestedRoll
    ) {

      return i + 2;
    }
  }


  return -1;
}


