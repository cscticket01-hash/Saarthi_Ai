// Saves every fee installment/payment in Google Sheet
// and the generated receipt PDF in Google Drive.
function saveFeePayment(data) {

  const receiptNo = String(data.receiptNo || "").trim();
  const paymentId = String(data.paymentId || "").trim();
  const studentId = String(data.studentId || "").trim();
  const studentName = String(data.studentName || data.name || "").trim();
  const studentClass = String(data.studentClass || data.class || "").trim();
  const rollNo = String(data.rollNo || data.roll || "").trim();
  const month = String(data.month || "").trim();
  const pdfBase64 = String(data.pdfBase64 || "").trim();

  if (!receiptNo) {
    throw new Error("Receipt No missing");
  }

  if (!studentName) {
    throw new Error("Student Name missing");
  }

  if (!studentClass) {
    throw new Error("Student Class missing");
  }

  if (!rollNo) {
    throw new Error("Roll No missing");
  }

  if (!pdfBase64) {
    throw new Error("Receipt PDF missing");
  }


  // ----------------------------------------------------------
  // RECEIPT PDF -> GOOGLE DRIVE
  // ----------------------------------------------------------

  const receiptFolder =
    getOrCreateFolder(
      FEE_RECEIPT_FOLDER
    );

  const cleanBase64 =
    pdfBase64.replace(
      /^data:application\/pdf;base64,/i,
      ""
    );

  let pdfBytes;

  try {
    pdfBytes =
      Utilities.base64Decode(
        cleanBase64
      );
  } catch (error) {
    throw new Error(
      "Invalid receipt PDF data"
    );
  }

  const pdfFileName =
    safeDriveFileName(receiptNo) +
    "_" +
    safeDriveFileName(studentName) +
    "_" +
    safeDriveFileName(studentClass) +
    "_Roll_" +
    safeDriveFileName(rollNo) +
    ".pdf";


  // Retry-safe: same receipt request dobara aaye to same file reuse hoga.
  let pdfFile = null;

  const sameNameFiles =
    receiptFolder.getFilesByName(
      pdfFileName
    );

  if (sameNameFiles.hasNext()) {

    pdfFile =
      sameNameFiles.next();

  } else {

    const pdfBlob =
      Utilities.newBlob(
        pdfBytes,
        "application/pdf",
        pdfFileName
      );

    pdfFile =
      receiptFolder.createFile(
        pdfBlob
      );
  }


  // WhatsApp receipt link ke liye public-link sharing try karega.
  // Google Workspace policy block kare to save operation phir bhi continue hoga.
  try {

    pdfFile.setSharing(
      DriveApp.Access.ANYONE_WITH_LINK,
      DriveApp.Permission.VIEW
    );

  } catch (error) {

    console.log(
      "Fee receipt sharing warning: " +
      error
    );
  }


  const fileId =
    pdfFile.getId();

  const fileUrl =
    "https://drive.google.com/file/d/" +
    fileId +
    "/view?usp=sharing";


  // ----------------------------------------------------------
  // PAYMENT -> GOOGLE SHEET
  // ----------------------------------------------------------

  const sheet =
    getOrCreateDatabaseSheet(
      FEE_SHEET_NAME,
      FEE_HEADERS
    );


  const feeItems =
    data.feeItems &&
    typeof data.feeItems === "object" &&
    !Array.isArray(data.feeItems)
      ? data.feeItems
      : {};


  const rowValues = [
    receiptNo,
    paymentId,
    studentId,
    studentName,
    studentClass,
    rollNo,
    data.parentContact || "",
    month,
    JSON.stringify(feeItems),
    toFeeNumber(data.expectedAmount),
    toFeeNumber(data.installmentAmount),
    toFeeNumber(data.totalPaid),
    toFeeNumber(data.balance),
    String(data.status || "").trim(),
    String(data.paymentMode || "").trim(),
    String(data.collectedBy || "").trim(),
    String(data.dateText || "").trim(),
    String(data.timeText || "").trim(),
    fileUrl,
    new Date()
  ];


  // Retry-safe: same receiptNo ke liye duplicate row nahi banega.
  const existingRow =
    findFeeReceiptRow(
      sheet,
      receiptNo
    );


  if (existingRow > 1) {

    sheet
      .getRange(
        existingRow,
        1,
        1,
        FEE_HEADERS.length
      )
      .setValues([
        rowValues
      ]);

  } else {

    sheet.appendRow(
      rowValues
    );
  }


  const sheetUrl =
    sheet
      .getParent()
      .getUrl();


  return jsonResponse({
    success: true,
    action: "save_fee_payment",
    message:
      "Fee payment Google Sheet aur receipt Google Drive me save ho gaya",
    receiptNo: receiptNo,
    fileId: fileId,
    fileUrl: fileUrl,
    sheetUrl: sheetUrl
  });
}


// ============================================================
// FIND FEE RECEIPT ROW
// ============================================================

function findFeeReceiptRow(
  sheet,
  receiptNo
) {

  const target =
    String(
      receiptNo || ""
    ).trim();

  if (!target) {
    return -1;
  }

  const lastRow =
    sheet.getLastRow();

  if (lastRow <= 1) {
    return -1;
  }


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        1
      )
      .getValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][0] || ""
      ).trim() === target
    ) {

      return i + 2;
    }
  }


  return -1;
}


