// ============================================================
// FIND TEACHER
// ============================================================

function findTeacherRow(
  sheet,
  teacherId,
  phone
) {

  const lastRow =
    sheet.getLastRow();


  if (lastRow <= 1) {
    return -1;
  }


  const requestedId =
    String(
      teacherId || ""
    ).trim();


  const requestedPhone =
    normalizePhone(
      phone
    );


  const values =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        TEACHER_HEADERS.length
      )
      .getValues();


  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    const rowId =
      String(
        values[i][0] ||
        ""
      ).trim();


    const rowPhone =
      normalizePhone(
        values[i][5]
      );


    // Teacher ID preferred
    if (
      requestedId &&
      rowId === requestedId
    ) {

      return i + 2;
    }


    // Phone fallback
    if (
      requestedPhone &&
      rowPhone ===
        requestedPhone
    ) {

      return i + 2;
    }
  }


  return -1;
}


