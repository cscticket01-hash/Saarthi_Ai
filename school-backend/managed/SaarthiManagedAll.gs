// ============================================================
// WINDOWS FIREBASE TEXT-ONLY SYNC SNAPSHOT
//
// IMPORTANT STORAGE POLICY:
// - Firebase receives text/number/boolean/map/list operational data only.
// - Photos, PDFs, report cards, receipt files, student documents,
//   branding images and their Drive URLs/File IDs are NOT included here.
// - Full windows_sync_snapshot remains available for Local DB / Google data.
// ============================================================

function firebaseForbiddenMediaKey_(key) {
  const blocked = {
    idCardUrl: true,
    photoUrl: true,
    photoBase64: true,
    photoMimeType: true,

    logoUrl: true,
    logoFileId: true,
    logoBase64: true,
    logoMimeType: true,
    logoFileName: true,

    sealUrl: true,
    sealFileId: true,
    sealBase64: true,
    sealMimeType: true,
    sealFileName: true,

    principalSignatureUrl: true,
    principalSignatureFileId: true,
    principalSignatureBase64: true,
    principalSignatureMimeType: true,
    principalSignatureFileName: true,

    schoolLogoUrl: true,
    schoolSealUrl: true,

    reportCardUrl: true,
    reportCardFileId: true,

    receiptPdfUrl: true,
    pdfBase64: true,

    fileUrl: true,
    fileId: true,
    fileBase64: true,
    downloadUrl: true,

    driveUrl: true,
    sheetUrl: true
  };

  return blocked[String(key || "")] === true;
}


function firebaseTextOnlyValue_(value) {
  if (Array.isArray(value)) {
    return value.map(function(item) {
      return firebaseTextOnlyValue_(item);
    });
  }

  if (
    value &&
    typeof value === "object" &&
    !(value instanceof Date)
  ) {
    const output = {};

    Object.keys(value).forEach(function(key) {
      if (firebaseForbiddenMediaKey_(key)) {
        return;
      }

      output[key] =
        firebaseTextOnlyValue_(value[key]);
    });

    return output;
  }

  return value;
}


