  rows.forEach(function(row) {
    const teacherId =
      String(row[0] || "").trim();

    if (!teacherId) {
      return;
    }

    let schedule = {};

    try {
      schedule = JSON.parse(
        String(row[14] || "{}")
      );
    } catch (_) {
      schedule = {};
    }

    output.push({
      documentId: teacherId,
      teacherId: teacherId,
      name: String(row[1] || ""),
      designation:
        String(row[2] || ""),
      subject:
        String(row[3] || ""),
      department:
        String(row[3] || ""),
      qualification:
        String(row[4] || ""),
      phone:
        String(row[5] || ""),
      mobile:
        String(row[5] || ""),
      email:
        String(row[6] || ""),
      dateOfBirth:
        String(row[7] || ""),
      joiningDate:
        String(row[8] || ""),
      address:
        String(row[9] || ""),
      assignedClasses:
        String(row[10] || ""),
      employmentType:
        String(row[11] || ""),
      status:
        String(row[12] || ""),
      photoUrl:
        String(row[13] || ""),
      schedule: schedule,
      timestamp:
        dateToMillis(row[15])
    });
  });

  return output;
}

function windowsReadAllStudentDocuments() {
  const sheet =
    getOrCreateDatabaseSheet(
      STUDENT_DOCUMENT_INDEX_SHEET,
      STUDENT_DOCUMENT_HEADERS
    );

  if (sheet.getLastRow() <= 1) {
    return [];
  }

  const rows = sheet
    .getRange(
      2,
      1,
      sheet.getLastRow() - 1,
      STUDENT_DOCUMENT_HEADERS.length
    )
    .getValues();

  const output = [];

  rows.forEach(function(row) {
    const item =
      studentDocumentRowToObject(row);

    if (item.documentId) {
      output.push(item);
    }
  });

  output.sort(function(a, b) {
    return Number(b.timestamp || 0) -
      Number(a.timestamp || 0);
  });

  return output;
}


// ============================================================
// GENERIC GOOGLE SHEET
// ============================================================

function getOrCreateDatabaseSheet(
  spreadsheetName,
  headers
) {

  let sheet = null;

  const schoolRoot = VS_schoolDriveRoot();
  const files = schoolRoot.getFilesByName(spreadsheetName);

  while (files.hasNext()) {

    const file =
      files.next();

    if (
      file.getMimeType() ===
      MimeType.GOOGLE_SHEETS
    ) {

      const spreadsheet =
        SpreadsheetApp.openById(
          file.getId()
        );

      sheet =
        spreadsheet
          .getSheets()[0];

      break;
    }
  }


  // Create if not found
  if (!sheet) {

    const spreadsheet =
      SpreadsheetApp.create(
        spreadsheetName
      );

    DriveApp.getFileById(spreadsheet.getId()).moveTo(schoolRoot);
    sheet =
      spreadsheet
        .getSheets()[0];
  }


  ensureHeaders(
    sheet,
    headers
  );

  return sheet;
}


// ============================================================
// HEADER CHECK
// ============================================================

function ensureHeaders(
  sheet,
  headers
) {

  if (
    sheet.getLastRow() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([
        headers
      ]);

    return;
  }


  const currentHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        Math.max(
          sheet.getLastColumn(),
          headers.length
        )
      )
      .getValues()[0];


  let needsUpdate = false;

  for (
    let i = 0;
    i < headers.length;
    i++
  ) {

    if (
      String(
        currentHeaders[i] || ""
      ).trim() !==
      headers[i]
    ) {

      needsUpdate = true;
      break;
    }
  }


  if (needsUpdate) {

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([
        headers
      ]);
  }
}


// ============================================================
// ROLL NORMALIZATION
//
// 1
// 01
// 001
// 0001
//
// ALL = 1
// ============================================================

function normalizeRoll(value) {

  let roll =
    String(
      value === null ||
      value === undefined
        ? ""
        : value
    ).trim();


  if (!roll) {
    return "";
  }


  // Only numeric Roll Nos
  if (/^\d+$/.test(roll)) {

    roll =
      roll.replace(
        /^0+(?=\d)/,
        ""
      );

    return roll;
  }


  // Non-numeric fallback
  return roll.toLowerCase();
}


// ============================================================
// CLASS NORMALIZATION
// ============================================================

function normalizeClass(value) {

  return String(
    value || ""
  )
    .trim()
    .replace(/\s+/g, " ")
    .toLowerCase();
}


// ============================================================
// PHONE NORMALIZATION
// ============================================================

function normalizePhone(value) {

  let phone =
    String(
      value || ""
    ).replace(/\D/g, "");


  // +91 / 91 handling
  if (
    phone.length === 12 &&
    phone.startsWith("91")
  ) {

    phone =
      phone.substring(2);
  }


  return phone;
}


