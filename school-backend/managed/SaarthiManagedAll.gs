function windowsReadAllStudents() {
  const sheet =
    getOrCreateDatabaseSheet(
      STUDENT_SHEET_NAME,
      STUDENT_HEADERS
    );

  if (sheet.getLastRow() <= 1) {
    return [];
  }

  const rows = sheet
    .getRange(
      2,
      1,
      sheet.getLastRow() - 1,
      STUDENT_HEADERS.length
    )
    .getValues();

  const output = [];

  rows.forEach(function(row) {
    const studentClass =
      String(row[2] || "").trim();
    const rollNo =
      String(row[3] || "").trim();

    if (!studentClass || !rollNo) {
      return;
    }

    output.push({
      documentId:
        studentClass +
        "_Roll_" +
        rollNo,
      name: String(row[0] || ""),
      parentName: String(row[1] || ""),
      class: studentClass,
      studentClass: studentClass,
      rollNo: rollNo,
      roll: rollNo,
      parentContact:
        String(row[4] || ""),
      contact:
        String(row[4] || ""),
      photoUrl:
        String(row[5] || ""),
      hostelFacility:
        String(row[6] || ""),
      address:
        String(row[7] || ""),
      district:
        String(row[8] || ""),
      state:
        String(row[9] || ""),
      pinCode:
        String(row[10] || ""),
      joiningDate:
        String(row[11] || ""),
      dateOfBirth:
        String(row[12] || ""),
      timestamp:
        dateToMillis(row[13])
    });
  });

  return output;
}

