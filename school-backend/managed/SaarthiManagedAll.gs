// ============================================================
// SCHOOL / BACKEND IDENTITY
//
// Cross-school safety contract:
// - Every Apps Script deployment has a stable backendInstanceId.
// - Once a School Sync ID is claimed, another school's ID cannot overwrite it.
// - Windows compares this ID with Firebase school_config/windows_sync_identity
//   before any Firebase <-> Google merge is allowed.
// ============================================================

function syncIdentityGet() {
  try {
    const properties = PropertiesService.getScriptProperties();
    const schoolSyncId = String(
      properties.getProperty("SAARTHI_SCHOOL_SYNC_ID") || ""
    ).trim();

    return jsonResponse({
      success: true,
      schoolSyncId: schoolSyncId,
      backendInstanceId: getOrCreateBackendInstanceId_(),
      version: SAARTHI_BACKEND_VERSION,
      timestamp: new Date().toISOString()
    });
  } catch (error) {
    return jsonResponse({
      success: false,
      message: "Google backend identity read failed",
      error: String(error),
      version: SAARTHI_BACKEND_VERSION
    });
  }
}

function syncIdentityClaim(data) {
  const requested = String(
    data && data.schoolSyncId ? data.schoolSyncId : ""
  ).trim();

  if (!requested || requested.length < 8 || requested.length > 200) {
    return jsonResponse({
      success: false,
      code: "INVALID_SCHOOL_SYNC_ID",
      message: "Valid School Sync ID required"
    });
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    const properties = PropertiesService.getScriptProperties();
    const existing = String(
      properties.getProperty("SAARTHI_SCHOOL_SYNC_ID") || ""
    ).trim();

    if (existing && existing !== requested) {
      return jsonResponse({
        success: false,
        code: "SCHOOL_SYNC_ID_MISMATCH",
        message:
          "This Google backend is already linked to another school identity.",
        schoolSyncId: existing,
        backendInstanceId: getOrCreateBackendInstanceId_()
      });
    }

    if (!existing) {
      properties.setProperty(
        "SAARTHI_SCHOOL_SYNC_ID",
        requested
      );
    }

    return jsonResponse({
      success: true,
      schoolSyncId: requested,
      backendInstanceId: getOrCreateBackendInstanceId_(),
      claimed: !existing,
      version: SAARTHI_BACKEND_VERSION,
      timestamp: new Date().toISOString()
    });
  } catch (error) {
    return jsonResponse({
      success: false,
      message: "Google backend identity claim failed",
      error: String(error),
      version: SAARTHI_BACKEND_VERSION
    });
  } finally {
    lock.releaseLock();
  }
}

function getOrCreateBackendInstanceId_() {
  const properties = PropertiesService.getScriptProperties();
  let id = String(
    properties.getProperty("SAARTHI_BACKEND_INSTANCE_ID") || ""
  ).trim();

  if (!id) {
    id = "GB-" + Utilities.getUuid();
    properties.setProperty(
      "SAARTHI_BACKEND_INSTANCE_ID",
      id
    );
  }

  return id;
}


