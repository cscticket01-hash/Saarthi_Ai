            tempSpreadsheet.getId()
          );
      }

      if (tempFile) {
        tempFile.setTrashed(true);
      }
    } catch (cleanupError) {
      console.log(
        "Temporary report sheet cleanup warning: " +
        cleanupError
      );
    }
  }
}


function examGrade(
  percentage,
  passed
) {
  if (!passed) return "F";
  if (percentage >= 90) return "A+";
  if (percentage >= 80) return "A";
  if (percentage >= 70) return "B+";
  if (percentage >= 60) return "B";
  if (percentage >= 50) return "C";
  if (percentage >= 40) return "D";
  return "E";
}


function findExamResultRow(
  sheet,
  examId,
  studentId
) {
  if (sheet.getLastRow() <= 1) {
    return -1;
  }

  const rows = sheet
    .getRange(
      2,
      1,
      sheet.getLastRow() - 1,
      3
    )
    .getValues();

  for (let i = 0; i < rows.length; i++) {
    if (
      String(rows[i][0] || "").trim() === examId &&
      String(rows[i][2] || "").trim() === studentId
    ) {
      return i + 2;
    }
  }

  return -1;
}


function findRowByFirstColumn(
  sheet,
  value
) {
  const target = String(value || "").trim();

  if (
    !target ||
    sheet.getLastRow() <= 1
  ) {
    return -1;
  }

  const values = sheet
    .getRange(
      2,
      1,
      sheet.getLastRow() - 1,
      1
    )
    .getValues();

  for (let i = 0; i < values.length; i++) {
    if (
      String(values[i][0] || "").trim() === target
    ) {
      return i + 2;
    }
  }

  return -1;
}


function getOrCreateChildFolder(
  parentFolder,
  folderName
) {
  const folders = parentFolder.getFoldersByName(
    folderName
  );

  if (folders.hasNext()) {
    return folders.next();
  }

  return parentFolder.createFolder(
    folderName
  );
}


function extractDriveFileId(url) {
  const value = String(url || "");

  let match = value.match(
    /\/d\/([^\/?]+)/i
  );

  if (!match) {
    match = value.match(
      /[?&]id=([^&]+)/i
    );
  }

  return match
    ? match[1]
    : "";
}


function dateToMillis(value) {
  if (
    Object.prototype.toString.call(value) ===
    "[object Date]"
  ) {
    return value.getTime();
  }

  const parsed = new Date(value);

  return isNaN(parsed.getTime())
    ? 0
    : parsed.getTime();
}


// ============================================================
// SAFE DRIVE FILE NAME
// ============================================================

function safeDriveFileName(value) {

  const cleaned =
    String(
      value || ""
    )
      .trim()
      .replace(
        /[\\/:*?"<>|#%{}[\]]/g,
        "_"
      )
      .replace(
        /\s+/g,
        "_"
      );

  return cleaned || "NA";
}


// ============================================================
// GENERIC IMAGE UPLOAD
// ============================================================

function uploadImageToDrive(
  folderName,
  data,
  defaultFileName
) {

  if (
    !data.photoBase64 ||
    !String(
      data.photoBase64
    ).trim()
  ) {

    throw new Error(
      "Photo Base64 missing"
    );
  }


  const folder =
    getOrCreateFolder(
      folderName
    );


  const base64Data =
    String(
      data.photoBase64
    ).replace(
      /^data:image\/[\w.+-]+;base64,/,
      ""
    );


  const bytes =
    Utilities.base64Decode(
      base64Data
    );


  const mimeType =
    String(
      data.photoMimeType ||
      "image/jpeg"
    );


  let extension = ".jpg";


  if (
    mimeType
      .toLowerCase()
      .includes("png")
  ) {

    extension = ".png";

  } else if (
    mimeType
      .toLowerCase()
      .includes("webp")
  ) {

    extension = ".webp";
  }


  const safeName =
    String(
      defaultFileName ||
      "Photo"
    )
      .replace(
        /[\\/:*?"<>|#%{}[\]]/g,
        "_"
      )
      .replace(
        /\s+/g,
        "_"
      );


  let fileName =
    safeName +
    extension;


  if (
    data.photoName &&
    String(
      data.photoName
    ).trim()
  ) {

    fileName =
      String(
        data.photoName
      ).trim();
  }


  const blob =
    Utilities.newBlob(
      bytes,
      mimeType,
      fileName
    );


  const photoFile =
    folder.createFile(
      blob
    );


  try {

    photoFile.setSharing(
      DriveApp.Access
        .ANYONE_WITH_LINK,

      DriveApp.Permission
        .VIEW
    );

  } catch (error) {

    console.log(
      "Photo sharing warning: " +
      error
    );
  }


  const fileId =
    photoFile.getId();


  const photoUrl =
    "https://lh3.googleusercontent.com/d/" +
    fileId +
    "=w800";


  return {
    success: true,
    fileId: fileId,
    url: photoUrl
  };
}


// ============================================================
// GET / CREATE FOLDER
// ============================================================

function getOrCreateFolder(
  folderName
) {

  const schoolRoot = VS_schoolDriveRoot();
  const folders = schoolRoot.getFoldersByName(folderName);


  if (folders.hasNext()) {

    return folders.next();
  }


  return schoolRoot.createFolder(folderName);
}


// ============================================================
// DELETE DRIVE PHOTO BY URL
// ============================================================

function deleteDrivePhotoByUrl(
  photoUrl
) {

  if (!photoUrl) {
    return false;
  }


  let match =
    String(
      photoUrl
    ).match(
      /googleusercontent\.com\/d\/([^=\/]+)/i
    );


  if (!match) {

    match =
      String(
        photoUrl
      ).match(
        /[?&]id=([^&]+)/i
      );
  }


  if (!match) {

    console.log(
      "Drive file ID nahi mila: " +
      photoUrl
    );

    return false;
  }


  const fileId =
    match[1];


  try {

    const file =
      VS_schoolFile(fileId);


    file.setTrashed(
      true
    );


    return true;

  } catch (error) {

    console.log(
      "Drive photo delete error: " +
      error
    );

    return false;
  }
}


