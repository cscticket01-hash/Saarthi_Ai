  );
}


// ------------------------------------------------------------
// ATTENDANCE DATE / TIME HELPERS
// ------------------------------------------------------------

function attendanceTimeZone() {
  return (
    Session.getScriptTimeZone() ||
    "Asia/Kolkata"
  );
}


function attendanceNowMeta() {
  const now = new Date();
  const timeZone = attendanceTimeZone();

  return {
    now: now,
    dateKey: Utilities.formatDate(
      now,
      timeZone,
      "yyyy-MM-dd"
    ),
    dateText: Utilities.formatDate(
      now,
      timeZone,
      "dd/MM/yyyy"
    ),
    timeText: Utilities.formatDate(
      now,
      timeZone,
      "hh:mm:ss a"
    )
  };
}


function normalizeAttendanceMode(value) {
  const mode = String(
    value || "entry"
  )
    .trim()
    .toLowerCase();

  if (
    mode === "exit" ||
    mode === "out" ||
    mode === "checkout" ||
    mode === "check-out"
  ) {
    return "exit";
  }

  return "entry";
}


function attendanceId(
  prefix,
  personId,
  dateKey
) {
  const cleanPerson =
    safeDriveFileName(
      personId || "UNKNOWN"
    );

  return (
    prefix +
    "-" +
    cleanPerson +
    "-" +
    String(dateKey || "")
      .replace(/\D/g, "")
  );
}


// ------------------------------------------------------------
// FIND ATTENDANCE ROW
// One person = one row per day.
// Duplicate scans never create duplicate attendance rows.
// ------------------------------------------------------------

function findAttendanceRow(
  sheet,
  idColumnIndex,
  personId,
  dateKey
) {
  const lastRow = sheet.getLastRow();

  if (lastRow <= 1) {
    return -1;
  }

  const values = sheet
    .getRange(
      2,
      1,
      lastRow - 1,
      sheet.getLastColumn()
    )
    .getValues();

  const targetId = String(
    personId || ""
  ).trim();

  const targetDate = String(
    dateKey || ""
  ).trim();

  for (
    let i = 0;
    i < values.length;
    i++
  ) {
    const rowPersonId = String(
      values[i][idColumnIndex - 1] || ""
    ).trim();

    // Date Key is column 6 in both attendance sheets.
    const rowDateKey = String(
      values[i][5] || ""
    ).trim();

    if (
      rowPersonId === targetId &&
      rowDateKey === targetDate
    ) {
      return i + 2;
    }
  }

  return -1;
}


// ------------------------------------------------------------
// STUDENT ATTENDANCE
// ------------------------------------------------------------

function markStudentAttendance(data) {
  const studentId = String(
    data.studentId ||
    data.personId ||
    data.id ||
    ""
  ).trim();

  let studentName = String(
    data.studentName ||
    data.name ||
    ""
  ).trim();

  let studentClass = String(
    data.studentClass ||
    data.class ||
    ""
  ).trim();

  let rollNo = String(
    data.rollNo ||
    data.roll ||
    ""
  ).trim();

  if (!studentId) {
    throw new Error(
      "Student ID required hai"
    );
  }

  // If class + roll are available, existing student sheet se
  // missing name/class/roll values fill karne ki koshish karega.
  if (studentClass && rollNo) {
    try {
      const studentSheet =
        getOrCreateDatabaseSheet(
          STUDENT_SHEET_NAME,
          STUDENT_HEADERS
        );

      const studentRow =
        findStudentRow(
          studentSheet,
          studentClass,
          rollNo
        );

      if (studentRow > 1) {
        const values =
          studentSheet
            .getRange(
              studentRow,
              1,
              1,
              STUDENT_HEADERS.length
            )
            .getValues()[0];

        if (!studentName) {
          studentName =
            String(values[0] || "").trim();
        }

        if (!studentClass) {
          studentClass =
            String(values[2] || "").trim();
        }

        if (!rollNo) {
          rollNo =
            String(values[3] || "").trim();
        }
      }
    } catch (lookupError) {
      console.log(
        "Student attendance lookup warning: " +
        lookupError
      );
    }
  }

  const meta = attendanceNowMeta();
  const mode =
    normalizeAttendanceMode(
      data.mode ||
      data.scanMode ||
      data.attendanceMode
    );

  const source = String(
    data.source ||
    data.scanSource ||
    "QR"
  ).trim();

  const markedBy = String(
    data.markedBy ||
    data.updatedBy ||
    ""
  ).trim();

  const sheet =
    getOrCreateDatabaseSheet(
      STUDENT_ATTENDANCE_SHEET_NAME,
      STUDENT_ATTENDANCE_HEADERS
    );

  const existingRow =
    findAttendanceRow(
      sheet,
      2,
      studentId,
      meta.dateKey
    );

  if (existingRow > 1) {
    const oldValues =
      sheet
        .getRange(
          existingRow,
          1,
          1,
          STUDENT_ATTENDANCE_HEADERS.length
        )
        .getValues()[0];

    const firstEntry =
      String(oldValues[7] || "").trim() ||
      meta.timeText;

    const oldExit =
      String(oldValues[9] || "").trim();

    const scanCount =
      Number(oldValues[11] || 0) + 1;

    const exitTime =
      mode === "exit"
        ? meta.timeText
        : oldExit;

    const status =
      mode === "exit"
        ? "EXIT"
        : "PRESENT";

    const rowValues = [
      String(oldValues[0] || attendanceId(
        "SAT",
        studentId,
        meta.dateKey
      )),
      studentId,
      studentName ||
        String(oldValues[2] || "") ||
        "Student",
      studentClass ||
        String(oldValues[3] || ""),
      rollNo ||
        String(oldValues[4] || ""),
      meta.dateKey,
      meta.dateText,
      firstEntry,
      meta.timeText,
      exitTime,
      status,
      scanCount,
      source ||
        String(oldValues[12] || "QR"),
      markedBy ||
        String(oldValues[13] || ""),
      meta.now
    ];

    sheet
      .getRange(
        existingRow,
        1,
        1,
        STUDENT_ATTENDANCE_HEADERS.length
      )
      .setValues([rowValues]);

    return jsonResponse({
      success: true,
      action:
        "mark_student_attendance",
      duplicate: mode !== "exit",
      updatedExisting: true,
      mode: mode,
      message:
        mode === "exit"
          ? "Student exit attendance updated"
          : "Student already present tha; duplicate row create nahi hua",
      attendance:
        studentAttendanceRowToObject(
          rowValues
        )
    });
  }

  if (mode === "exit") {
    throw new Error(
      "Aaj ka student entry attendance nahi mila; pehle Entry scan karein"
    );
  }

  const rowValues = [
    attendanceId(
      "SAT",
      studentId,
      meta.dateKey
    ),
    studentId,
    studentName || "Student",
    studentClass,
    rollNo,
    meta.dateKey,
    meta.dateText,
    meta.timeText,
    meta.timeText,
    "",
    "PRESENT",
    1,
    source,
    markedBy,
    meta.now
  ];

  sheet.appendRow(rowValues);

  return jsonResponse({
    success: true,
    action:
      "mark_student_attendance",
    duplicate: false,
    updatedExisting: false,
    mode: "entry",
    message:
      "Student attendance marked PRESENT",
    attendance:
      studentAttendanceRowToObject(
        rowValues
      )
  });
}


function studentAttendanceRowToObject(
  row
) {
  return {
    attendanceId:
      String(row[0] || ""),
    studentId:
      String(row[1] || ""),
    studentName:
      String(row[2] || ""),
    studentClass:
      String(row[3] || ""),
    rollNo:
      String(row[4] || ""),
    dateKey:
      String(row[5] || ""),
    dateText:
      String(row[6] || ""),
    firstEntryTime:
      String(row[7] || ""),
    lastScanTime:
      String(row[8] || ""),
    exitTime:
      String(row[9] || ""),
    status:
      String(row[10] || ""),
    scanCount:
      Number(row[11] || 0),
    source:
      String(row[12] || ""),
    markedBy:
      String(row[13] || ""),
    timestamp:
      dateToMillis(row[14])
  };
}


function listStudentAttendance(data) {
  const sheet =
    getOrCreateDatabaseSheet(
      STUDENT_ATTENDANCE_SHEET_NAME,
      STUDENT_ATTENDANCE_HEADERS
    );

  const studentId = String(
    data.studentId ||
    data.personId ||
    ""
  ).trim();

  const studentClass =
    normalizeClass(
      data.studentClass ||
      data.class ||
      ""
    );

  const dateKey = String(
    data.dateKey ||
    data.date ||
    ""
  ).trim();

  const rows =
    sheet.getLastRow() <= 1
      ? []
      : sheet
          .getRange(
            2,
            1,
            sheet.getLastRow() - 1,
            STUDENT_ATTENDANCE_HEADERS.length
          )
          .getValues();

  const attendance = [];

  for (
    let i = rows.length - 1;
    i >= 0;
    i--
  ) {
    const item =
      studentAttendanceRowToObject(
        rows[i]
      );

    if (
      studentId &&
      item.studentId !== studentId
    ) {
      continue;
    }

    if (
      studentClass &&
      normalizeClass(
        item.studentClass
      ) !== studentClass
    ) {
      continue;
    }

    if (
      dateKey &&
      item.dateKey !== dateKey
    ) {
      continue;
    }

    attendance.push(item);
  }

  return jsonResponse({
    success: true,
    action:
      "list_student_attendance",
    count: attendance.length,
    attendance: attendance,
    sheetUrl:
      sheet.getParent().getUrl()
  });
}


