function VS_legacyDoPost(e) {
  // All legacy actions require verified school-admin proof. Mobile actions
  // are handled by the companion adapter, before the legacy router can run.
  const mobileResponse = VS_handleMobile(e);
  if (mobileResponse) return mobileResponse;
  try {

    if (
      !e ||
      !e.postData ||
      !e.postData.contents
    ) {
      throw new Error("Request body missing");
    }

    const data = JSON.parse(
      e.postData.contents
    );

    if (
      !data ||
      typeof data !== "object" ||
      Array.isArray(data)
    ) {
      throw new Error(
        "Invalid request data"
      );
    }

    const action =
      String(
        data.action || ""
      ).trim();

    // ========================================================
    // WINDOWS SCHOOL IDENTITY GUARD
    // ========================================================
    // Existing Website / Android requests do not send this field and remain
    // backward compatible. Windows isolated profiles DO send it. If a stale
    // app page points at another school's script, the request is rejected
    // before any read/write/delete action can run.
    if (
      action !== "sync_identity_get" &&
      action !== "sync_identity_claim" &&
      action !== "health_check" &&
      action !== "ping"
    ) {
      const expectedSchoolSyncId = String(
        data._windowsSchoolSyncId || ""
      ).trim();

      if (expectedSchoolSyncId) {
        const actualSchoolSyncId = String(
          PropertiesService.getScriptProperties()
            .getProperty("SAARTHI_SCHOOL_SYNC_ID") || ""
        ).trim();

        if (
          !actualSchoolSyncId ||
          actualSchoolSyncId !== expectedSchoolSyncId
        ) {
          return jsonResponse({
            success: false,
            code: "SCHOOL_SYNC_ID_MISMATCH",
            message:
              "Windows school isolation blocked this Google backend request."
          });
        }
      }
    }


    // ========================================================
    // HEALTH CHECK / WINDOWS LED
    // ========================================================

    if (
      action === "health_check" ||
      action === "ping"
    ) {
      return healthCheck();
    }

    if (action === "windows_sync_snapshot") {
      return windowsSyncSnapshot(data);
    }

    // Firebase-safe snapshot:
    // Media/files/Drive URLs are stripped before Firebase sync.
    // Full windows_sync_snapshot stays unchanged for Local/Google use.
    if (action === "windows_sync_text_snapshot") {
      return windowsSyncTextSnapshot(data);
    }

    if (action === "sync_identity_get") {
      return syncIdentityGet();
    }

    if (action === "sync_identity_claim") {
      return syncIdentityClaim(data);
    }


    // ========================================================
    // STUDENT ACTIONS
    // ========================================================

    if (action === "add_student") {
      return addStudent(data);
    }

    if (action === "edit_student") {
      return editStudent(data);
    }

    if (action === "delete_student") {
      return deleteStudent(data);
    }

    if (action === "change_student_class") {
      return changeStudentClass(data);
    }


    // ========================================================
    // TEACHER ACTIONS
    // ========================================================

    if (action === "add_teacher") {
      return addTeacher(data);
    }

    if (action === "edit_teacher") {
      return editTeacher(data);
    }

    if (action === "delete_teacher") {
      return deleteTeacher(data);
    }

    if (
      action ===
      "update_teacher_schedule"
    ) {
      return updateTeacherSchedule(
        data
      );
    }


    // ========================================================
    // FEES ACTIONS
    // ========================================================

    if (action === "save_fee_payment") {
      return saveFeePayment(data);
    }

    if (action === "list_fee_payments") {
      return listFeePayments(data);
    }

    if (action === "list_school_expenses") {
      return listSchoolExpenses(data);
    }

    if (action === "save_school_expense") {
      return saveSchoolExpense(data);
    }

    if (action === "delete_school_expense") {
      return deleteSchoolExpense(data);
    }


    // ========================================================
    // STUDENT DOCUMENT ACTIONS
    // ========================================================

    if (action === "list_student_documents") {
      return listStudentDocuments(data);
    }

    if (action === "upload_student_document") {
      return uploadStudentDocument(data);
    }

    if (action === "delete_student_document") {
      return deleteStudentDocument(data);
    }


    // ========================================================
    // EXAM CENTER ACTIONS
    // ========================================================

    if (action === "list_exam_center") {
      return listExamCenter(data);
    }

    if (action === "save_exam") {
      return saveExam(data);
    }

    if (action === "save_exam_result") {
      return saveExamResult(data);
    }


    // ========================================================
    // ATTENDANCE ACTIONS
    // ========================================================

    if (action === "mark_attendance") {
      return markAttendance(data);
    }

    if (action === "mark_student_attendance") {
      return markStudentAttendance(data);
    }

    if (action === "mark_teacher_attendance") {
      return markTeacherAttendance(data);
    }

    if (action === "list_student_attendance") {
      return listStudentAttendance(data);
    }

    if (action === "list_teacher_attendance") {
      return listTeacherAttendance(data);
    }


    // ========================================================
    // SCHOOL PROFILE / BRANDING ACTIONS
    // ========================================================

    if (action === "get_school_profile") {
      return getSchoolProfile(data);
    }

    if (action === "save_school_profile") {
      return saveSchoolProfile(data);
    }


    throw new Error(
      "Invalid action: " + action
    );

  } catch (error) {

    console.error(error);

    return jsonResponse({
      success: false,
      message: String(error)
    });
  }
}


