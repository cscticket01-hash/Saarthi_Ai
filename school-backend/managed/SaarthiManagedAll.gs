// ============================================================

function listStudentDocuments(data) {
  const studentId = String(data.studentId || "").trim();
  const studentClass = normalizeClass(data.studentClass || data.class || "");
  const rollNo = normalizeRoll(data.rollNo || data.roll || "");

  const sheet = getOrCreateDatabaseSheet(
    STUDENT_DOCUMENT_INDEX_SHEET,
    STUDENT_DOCUMENT_HEADERS
  );

  const docs = [];

  if (sheet.getLastRow() > 1) {
    const rows = sheet
      .getRange(
        2,
        1,
        sheet.getLastRow() - 1,
        STUDENT_DOCUMENT_HEADERS.length
      )
      .getValues();

    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];

      const sameStudentId =
        studentId &&
        String(row[1] || "").trim() === studentId;

      const sameClassRoll =
        !studentId &&
        normalizeClass(row[3]) === studentClass &&
        normalizeRoll(row[4]) === rollNo;

      if (!sameStudentId && !sameClassRoll) {
        continue;
      }

      docs.push(studentDocumentRowToObject(row));
    }
  }

  docs.sort(function(a, b) {
    return Number(b.timestamp || 0) - Number(a.timestamp || 0);
  });

  let totalBytes = 0;
  docs.forEach(function(doc) {
    totalBytes += Number(doc.sizeBytes || 0);
  });

  return jsonResponse({
    success: true,
    action: "list_student_documents",
    documents: docs,
    totalBytes: totalBytes,
    maxBytes: STUDENT_DOCUMENT_MAX_BYTES
  });
}


function uploadStudentDocument(data) {
  const studentId = String(data.studentId || "").trim();
  const studentName = String(data.studentName || data.name || "Student").trim();
  const studentClass = String(data.studentClass || data.class || "").trim();
  const rollNo = String(data.rollNo || data.roll || "").trim();
  const documentName = String(data.documentName || "Document").trim();
  const originalFileName = String(data.fileName || "document").trim();
  const mimeType = String(data.mimeType || "").toLowerCase().trim();
  const fileBase64 = String(data.fileBase64 || "").trim();
  const replaceDocumentId = String(data.replaceDocumentId || "").trim();
  const uploadedBy = String(data.uploadedBy || "").trim();

  if (!studentId) {
    throw new Error("Student ID missing");
  }

  if (!studentClass || !rollNo) {
    throw new Error("Student Class aur Roll No required hain");
  }

  if (!fileBase64) {
    throw new Error("Document file missing");
  }

  if (
    mimeType !== "application/pdf" &&
    mimeType !== "image/jpeg" &&
    mimeType !== "image/jpg"
  ) {
    throw new Error("Sirf PDF/JPG/JPEG document allowed hai");
  }

  const cleanBase64 = fileBase64.replace(
    /^data:[^;]+;base64,/i,
    ""
  );

  let bytes;
  try {
    bytes = Utilities.base64Decode(cleanBase64);
  } catch (error) {
    throw new Error("Document file invalid hai");
  }

  const fileSize = bytes.length;

  if (fileSize <= 0) {
    throw new Error("Document empty hai");
  }

  if (fileSize > STUDENT_DOCUMENT_MAX_BYTES) {
    throw new Error("Single document 2 MB se bada nahi ho sakta");
  }

  const sheet = getOrCreateDatabaseSheet(
    STUDENT_DOCUMENT_INDEX_SHEET,
    STUDENT_DOCUMENT_HEADERS
  );

  let currentTotal = 0;
  let replaceRow = -1;
  let oldFileId = "";

  if (sheet.getLastRow() > 1) {
    const rows = sheet
      .getRange(
        2,
        1,
        sheet.getLastRow() - 1,
        STUDENT_DOCUMENT_HEADERS.length
      )
      .getValues();

    for (let i = 0; i < rows.length; i++) {
      if (String(rows[i][1] || "").trim() !== studentId) {
        continue;
      }

      const rowDocumentId = String(rows[i][0] || "").trim();

      if (
        replaceDocumentId &&
        rowDocumentId === replaceDocumentId
      ) {
        replaceRow = i + 2;
        oldFileId = String(rows[i][9] || "").trim();
        continue;
      }

      currentTotal += Number(rows[i][8] || 0);
    }
  }

  if (
    currentTotal + fileSize >
    STUDENT_DOCUMENT_MAX_BYTES
  ) {
    throw new Error(
      "Is student ke sab documents mila kar maximum 2 MB allowed hai"
    );
  }

  const rootFolder = getOrCreateFolder(
    STUDENT_DOCUMENT_ROOT_FOLDER
  );

  const studentFolderName =
    safeDriveFileName(studentClass) +
    "_Roll_" +
    safeDriveFileName(rollNo) +
    "_" +
    safeDriveFileName(studentId);

  const studentFolder = getOrCreateChildFolder(
    rootFolder,
    studentFolderName
  );

  let extension = ".pdf";
  if (
    mimeType === "image/jpeg" ||
    mimeType === "image/jpg"
  ) {
    extension = ".jpg";
  }

  let finalFileName = safeDriveFileName(
    documentName
  ) + extension;

  if (originalFileName) {
    const cleanedOriginal =
      safeDriveFileName(
        originalFileName.replace(/\.[^.]+$/, "")
      );

    finalFileName =
      cleanedOriginal +
      extension;
  }

  const blob = Utilities.newBlob(
    bytes,
    mimeType === "image/jpg"
      ? "image/jpeg"
      : mimeType,
    finalFileName
  );

  const newFile = studentFolder.createFile(blob);
  const fileId = newFile.getId();
  const fileUrl =
    "https://drive.google.com/file/d/" +
    fileId +
    "/view";

  const documentId =
    replaceDocumentId ||
    (
      "DOC-" +
      new Date().getTime() +
      "-" +
      Utilities.getUuid()
        .substring(0, 6)
        .toUpperCase()
    );

  const rowValues = [
    documentId,
    studentId,
    studentName,
    studentClass,
    rollNo,
    documentName,
    finalFileName,
    mimeType === "image/jpg"
      ? "image/jpeg"
      : mimeType,
    fileSize,
    fileId,
    fileUrl,
    uploadedBy,
    new Date()
  ];

  if (replaceRow > 1) {
    sheet
      .getRange(
        replaceRow,
        1,
        1,
        STUDENT_DOCUMENT_HEADERS.length
      )
      .setValues([rowValues]);

    if (
      oldFileId &&
      oldFileId !== fileId
    ) {
      try {
        DriveApp
          .getFileById(oldFileId)
          .setTrashed(true);
      } catch (error) {
        console.log(
          "Old student document delete warning: " +
          error
        );
      }
    }
  } else {
    sheet.appendRow(rowValues);
  }

  return jsonResponse({
    success: true,
    action: "upload_student_document",
    message:
      replaceRow > 1
        ? "Student document replaced successfully"
        : "Student document uploaded successfully",
    document: studentDocumentRowToObject(rowValues),
    totalBytes: currentTotal + fileSize,
    maxBytes: STUDENT_DOCUMENT_MAX_BYTES
  });
}


function deleteStudentDocument(data) {
  const studentId = String(data.studentId || "").trim();
  const documentId = String(data.documentId || "").trim();

  if (!studentId || !documentId) {
    throw new Error("Student ID aur Document ID required hain");
  }

  const sheet = getOrCreateDatabaseSheet(
    STUDENT_DOCUMENT_INDEX_SHEET,
    STUDENT_DOCUMENT_HEADERS
  );

  if (sheet.getLastRow() <= 1) {
    throw new Error("Document record nahi mila");
  }

  const rows = sheet
    .getRange(
      2,
      1,
      sheet.getLastRow() - 1,
      STUDENT_DOCUMENT_HEADERS.length
    )
    .getValues();

  let rowNumber = -1;
  let fileId = "";

  for (let i = 0; i < rows.length; i++) {
    if (
      String(rows[i][0] || "").trim() === documentId &&
      String(rows[i][1] || "").trim() === studentId
    ) {
      rowNumber = i + 2;
      fileId = String(rows[i][9] || "").trim();
      break;
    }
  }

  if (rowNumber === -1) {
    throw new Error("Document record nahi mila");
  }

  if (fileId) {
    try {
      DriveApp
        .getFileById(fileId)
        .setTrashed(true);
    } catch (error) {
      console.log(
        "Student document delete warning: " +
        error
      );
    }
  }

  sheet.deleteRow(rowNumber);

  return jsonResponse({
    success: true,
    action: "delete_student_document",
    message: "Student document deleted successfully"
  });
}


function studentDocumentRowToObject(row) {
  return {
    documentId: String(row[0] || ""),
    studentId: String(row[1] || ""),
    studentName: String(row[2] || ""),
    studentClass: String(row[3] || ""),
    rollNo: String(row[4] || ""),
    documentName: String(row[5] || ""),
    fileName: String(row[6] || ""),
    mimeType: String(row[7] || ""),
    sizeBytes: Number(row[8] || 0),
    fileId: String(row[9] || ""),
    fileUrl: String(row[10] || ""),
    uploadedBy: String(row[11] || ""),
    timestamp: dateToMillis(row[12])
  };
}





