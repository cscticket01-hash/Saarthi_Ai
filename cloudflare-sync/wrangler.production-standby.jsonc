{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidya-saarthi-sync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LANES",
        "class_name": "SyncLane"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SyncLane"
      ]
    }
  ],
  "vars": {
    "BROKER_URL": "https://saarthi-oauth-staging.onrender.com/school-cloud",
    "R2_STAGING_ENABLED": "false",
    "R2_STAGING_SCHOOLS": "",
    "R2_STAGING_ALL_SCHOOLS_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "r2_buckets": [
    {
      "binding": "R2_STAGE",
      "bucket_name": "saarthi-sync-r2-prod"
    }
  ]
}
