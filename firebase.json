{
  "hosting": {
    "target": "vidyasaarthi",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.platform.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
