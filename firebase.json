{
  "hosting": {
    "target": "vidyasaarthi",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/downloads/windows.exe",
        "destination": "https://saarthi-oauth-staging.onrender.com/downloads/windows.exe",
        "type": 302
      },
      {
        "source": "/downloads/android.apk",
        "destination": "https://saarthi-oauth-staging.onrender.com/downloads/android.apk",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.platform.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
